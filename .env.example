APP_NAME=RouterVault
APP_ENV=production
APP_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

POSTGRES_DB=routervault
POSTGRES_USER=routervault
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://routervault:CHANGE_ME_DB_PASSWORD@db:5432/routervault

MINIO_ROOT_USER=routervault
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=routervault
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=routervault
S3_REGION=us-east-1

SFTP_USER=backup
SFTP_PASSWORD=CHANGE_ME_SFTP_PASSWORD
SFTP_PORT=2222
INGEST_DIR=/ingest
