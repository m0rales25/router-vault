APP_NAME=RouterVault
APP_ENV=production
APP_SECRET=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

POSTGRES_DB=routervault
POSTGRES_USER=routervault
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://routervault:CHANGE_ME@db:5432/routervault

MINIO_ROOT_USER=routervault
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=routervault
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=routervault
S3_REGION=us-east-1

SFTP_USER=rvbackup
SFTP_PASSWORD=CHANGE_ME
SFTP_PORT=2222
INGEST_DIR=/ingest

# Optional V2 HTTPS profile
ROUTERVAULT_DOMAIN=routervault.example.com
